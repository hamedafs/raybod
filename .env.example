# OpenRouter (recommended for trying free models)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash:free
OPENROUTER_HTTP_REFERER=

# Alternative: Google AI Studio Gemini. If GEMINI_API_KEY is set, these settings take priority.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-deploying
SESSION_SECRET=change-this-to-a-long-random-secret
DATABASE_URL=sqlite:///./data/rayebod.db
